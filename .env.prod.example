# Шаблон прод-окружения. Скопировать в .env на сервере и заполнить реальными значениями.
# Файл .env в git не коммитится (см. .gitignore) — на сервер его передают отдельно.
# Подробности и порядок выкатки — README.md, раздел «Прод: деплой».

# --- Django ---
# В проде обязательно 0: при 1 включаются отладочные страницы и фиксированный код подтверждения.
DEBUG=0
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Домены, на которых отвечает API. Через запятую, без пробелов, без схемы.
DJANGO_ALLOWED_HOSTS=api.example.com
# Нужно для HTTPS-форм админки Django (со схемой!).
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Публичное имя сервера для nginx (то же, что в DJANGO_ALLOWED_HOSTS).
SERVER_NAME=api.example.com
# Редирект http → https и HSTS. Оставьте 1 в проде; 0 — только для отладки за прокси.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=2592000
# Включать только когда уверены, что ВСЕ поддомены ходят по HTTPS.
SECURE_HSTS_PRELOAD=0
# Код подтверждения для локальной разработки — в проде не задаётся.
DEBUG_CONFIRMATION_CODE=

# --- PostgreSQL ---
POSTGRES_DB=hvostiki
POSTGRES_USER=hvostiki
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- RabbitMQ (брокер Celery) ---
RABBITMQ_DEFAULT_USER=hvostiki
RABBITMQ_DEFAULT_PASS=
CELERY_BROKER_URL=amqp://hvostiki:пароль@rabbitmq:5672//

# --- Redis (кеш, рейт-лимиты, результаты задач) ---
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/1

# --- uCaller (звонок с кодом подтверждения) ---
UCALLER_SERVICE_ID=
UCALLER_API_KEY=

# --- Firebase (push) ---
# Путь внутри контейнера; файл монтируется томом из каталога secrets/ на сервере.
FIREBASE_CREDENTIALS_FILE=/app/firebase-key.json

# --- Медиа ---
# По умолчанию файловая система (том media). Для S3-совместимого хранилища
# укажите storages.backends.s3.S3Storage и добавьте пакет django-storages.
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
PRIVATE_STORAGE_BACKEND=tracker.storage.PrivateFileSystemStorage
# Отдавать /media/ силами Django (1) или nginx (0). В проде за nginx — 0.
SERVE_MEDIA=0

# --- Сроки хранения и лимиты ---
NOTIFICATION_RETENTION_DAYS=180
FEEDBACK_LOGS_RETENTION_DAYS=30
FEEDBACK_THROTTLE_RATE=5/hour

# --- Канал доставки обращений (заглушка в лог; для Telegram — свой класс) ---
FEEDBACK_NOTIFIER=tracker.services.feedback_notifier.LogNotifier

# --- gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
