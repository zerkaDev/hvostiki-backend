# nginx для прод-стека «Хвостиков»: терминирует HTTP(S), раздаёт статику и медиа,
# остальное проксирует в gunicorn.
#
# HTTPS: строки в блоке `listen 443 ssl` закомментированы, потому что сертификата при
# первом запуске ещё нет. Порядок включения — в README, раздел «HTTPS (Let's Encrypt)».
#
# Имя сервера берётся из переменной окружения SERVER_NAME (docker compose подставляет её
# через шаблоны nginx): по умолчанию `_` — отвечать на любой Host.

upstream hvostiki_web {
    server web:8000;
    keepalive 16;
}

# Ограничение частоты на чувствительные ручки: код подтверждения жжёт платные звонки uCaller.
limit_req_zone $binary_remote_addr zone=auth_code:10m rate=10r/m;

server {
    # Обе семьи адресов: AAAA-запись полезна для клиентов с IPv6, а IPv4 остаётся
    # обязательным (uCaller и часть мобильных сетей работают только по IPv4).
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    # Скриншот (10 МБ) + журнал (2 МБ) + запас на multipart.
    client_max_body_size 16m;

    # Логи: свой формат с реальным IP клиента (за прокси) и временем обработки.
    access_log /var/log/nginx/access.log combined;
    error_log /var/log/nginx/error.log warn;

    # --- HTTPS (раскомментировать после выпуска сертификата) ---
    # listen 443 ssl;
    # listen [::]:443 ssl;
    # http2 on;
    # ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_prefer_server_ciphers off;
    # ssl_session_cache shared:SSL:10m;
    # ssl_session_timeout 1d;
    # add_header Strict-Transport-Security "max-age=2592000" always;

    # --- ACME-челлендж для certbot (webroot) ---
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Healthcheck: без access-логов, чтобы не засорять журнал.
    location = /healthz {
        access_log off;
        proxy_pass http://hvostiki_web;
        proxy_set_header Host $host;
    }

    # Отправка кода подтверждения — жёсткий лимит по IP (в приложении есть кулдаун на номер).
    location = /auth/send-code/ {
        limit_req zone=auth_code burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://hvostiki_web;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    # Статика Django (collectstatic кладёт её в общий том).
    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Медиа пользователей: аватары, фото питомцев, скриншоты обращений.
    # Журналы приложения здесь не лежат — они в приватном хранилище (private_media).
    location /media/ {
        alias /app/media/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://hvostiki_web;
        include /etc/nginx/conf.d/proxy_params.conf;
    }
}
